<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Rock and Stone</li>
        </mods>
		
        <match Class="PatchOperationSequence">
            <operations>

                <li Class="PatchOperationAdd">
                    <xpath>Defs/TerrainDef[@Name="RaS_StoneBase"]</xpath>
                    <value>
                        <researchPrerequisites>
                            <li>Stonecutting</li>
                        </researchPrerequisites>
                    </value>
                </li>

                <li Class="PatchOperationAdd">
                    <xpath>Defs/TerrainDef[@Name="RaS_SmoothStoneBase"]</xpath>
                    <value>
                        <researchPrerequisites>
                            <li>Stonecutting</li>
                        </researchPrerequisites>
                    </value>
                </li>

            </operations>
        </match>
    </Operation>
</Patch>