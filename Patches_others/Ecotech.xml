<?xml version="1.0" encoding="utf-8" ?>
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Ecotech</li>
        </mods>
		
        <match Class="PatchOperationSequence">
            <operations>

                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="ET_BasicResearchBench"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Production</designationCategory>
                    </value>
                </li>

                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="ET_GlowsapBay"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Production</designationCategory>
                    </value>
                </li>
                
                <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="ET_GlowsapBasinResearch"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Production</designationCategory>
                    </value>
                </li>

                 <li Class="PatchOperationReplace">
                    <xpath>Defs/ThingDef[defName="ET_TerramassWall"]/designationCategory</xpath>
                    <value>
                        <designationCategory>Structure</designationCategory>
                    </value>
                </li>

                <li Class="PatchOperationRemove">
                    <xpath>Defs/DesignationCategoryDef[defName="EcotechDesignation"]</xpath>
                </li>

            </operations>
        </match>
    </Operation>
</Patch>